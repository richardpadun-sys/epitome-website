# Copy this file to .env.local for local development, and set the same
# two variables in your hosting provider's dashboard for production
# (Vercel: Project Settings -> Environment Variables). Never commit the
# real values — .env.local is already in .gitignore.

# Resend API key. Get one at https://resend.com after creating an account
# (Dashboard -> API Keys -> Create API Key). Starts with "re_".
RESEND_API_KEY=

# The "From" address emails are sent as. Must be on a domain you have
# verified with Resend (Dashboard -> Domains -> Add Domain), which needs
# DNS records added at your domain registrar — see the deployment report
# for exactly which records. Format: "Display Name <address@yourdomain.com>"
RESEND_FROM_EMAIL=
